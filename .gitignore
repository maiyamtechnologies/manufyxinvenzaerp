# Scratch / probe scripts (tests/_*.py, tests/zz_tmp_*.py): one-off investigation code,
# kept locally, never committed -- some of them change data when run. Real checks are
# tests/verify_*.py and tests/test_*.py. __init__.py (and the July scripts already
# tracked) are unaffected: .gitignore never untracks a tracked file.
manufyxinvenzaerp/tests/_*.py
!manufyxinvenzaerp/tests/__init__.py
manufyxinvenzaerp/tests/zz_tmp_*.py
